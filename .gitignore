.DS_Store

# Build output. CMake presets build into build/<preset>; build-*/ covers
# hand-named build trees.
/build/
/build-*/
/out/
/dist/
compile_commands.json
.cache/

# In-source CMake builds. Listed by name rather than *.cmake so that CMake
# modules added under cmake/ are never silently ignored.
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# JavaScript
node_modules/
