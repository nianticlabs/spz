export enum SpzExtensionType {
  SPZ_ADOBE_safe_orbit_camera = 0xADBE0002,
  SPZ_ADOBE_coordinate_system = 0xADBE0003,
  SPZ_ADOBE_environment_map = 0xADBE0005,
  SPZ_NIANTIC_georeference = 0x4E530001,
  SPZ_NIANTIC_custom_attribute = 0x4E530002,
}

export enum GeoreferenceCrsEncoding {
  AUTHORITY_CODE = 0,
  PROJJSON = 1,
}

export class SpzExtensionBase {
  readonly extensionType: SpzExtensionType;
}

export class SpzExtensionSafeOrbitCameraAdobe extends SpzExtensionBase {
  safeOrbitElevationMin: number;
  safeOrbitElevationMax: number;
  safeOrbitRadiusMin: number;
  constructor();
  static type(): SpzExtensionType;
}

export class SpzExtensionCoordinateSystemAdobe extends SpzExtensionBase {
  coordinateSystem: CoordinateSystem;
  constructor();
  static type(): SpzExtensionType;
}
/**
 * Equirectangular RGB environment map with the frame it is looked up in; at most one per cloud.
 * Pixel column = azimuth about `up` measured from `e1` toward `e2`, -pi..pi -> 0..width; pixel row =
 * angle from `up`, 0..pi -> 0..height. `origin`, `up`, `e1` and `e2` follow coordinate conversions
 * like positions. Saving fails unless width, height >= 1, pixels.length == width * height * 3, and
 * all values are finite (pixels within +-65504).
 */
export class SpzExtensionEnvironmentMapAdobe extends SpzExtensionBase {
  width: number;
  height: number;
  /** height * width * 3 values, row-major, RGB interleaved; stored as float16. Reading returns a copy; assign to replace. */
  pixels: Float32Array;
  origin: [number, number, number];
  up: [number, number, number];
  e1: [number, number, number];
  e2: [number, number, number];
  /** Free-form UTF-8 (JSON by convention), never converted. */
  metadata: string;
  constructor();
  static type(): SpzExtensionType;
}

export class SpzExtensionGeoreferenceNiantic extends SpzExtensionBase {
  /** Target geocentric CRS, e.g. `"EPSG:4978"` or inline PROJJSON; required. */
  crs: string;
  /** Serialization of `crs`: AUTHORITY_CODE (default) or PROJJSON (only when no code exists). */
  crsEncoding: GeoreferenceCrsEncoding;
  /** Translation from the RUB origin to the target CRS, in meters (x, y, z). Returns a copy; assign the whole tuple. */
  origin: readonly [number, number, number];
  /** Unit Hamilton quaternion (x, y, z, w) rotating RUB positions into the target CRS; near-unit values are normalized on save. Returns a copy; assign the whole tuple. */
  rotation: readonly [number, number, number, number];
  /** Dimensionless uniform scale from RUB positions into the target CRS; must be finite and > 0. */
  scale: number;
  /** Coordinate epoch of the transformed coordinates, as a decimal year; NaN when absent. */
  epoch: number;
  constructor();
  static type(): SpzExtensionType;
}

/** How a custom attribute responds to coordinate conversions. */
export enum SpzAttributeSemantic {
  /** Never converted. */
  CUSTOM = 0,
  /** xyz triples in the cloud's coordinate space, converted like positions; dim must be a multiple of 3. */
  SPATIAL = 1,
}

/**
 * A named per-point attribute, stored in SPZ v4 files in extension frames (zstd skippable frames).
 * Saving fails unless name is 1-65535 bytes of printable ASCII and unique in the cloud, bits is 32 or 1-16,
 * and the values hold numPoints * dim floats, point-major.
 */
export class SpzExtensionCustomAttributeNiantic extends SpzExtensionBase {
  name: string;
  dim: number;
  semantic: SpzAttributeSemantic;
  bits: number;
  constructor();
  /** Returns a copy of the values: numPoints * dim floats, point-major. */
  getValues(): Float32Array;
  /** Replaces the values with a copy of the given array. */
  setValues(values: Float32Array | number[]): void;
  static type(): SpzExtensionType;
}

/** Returns true if the PLY extra element name is handled by an extension. */
export function isKnownPlyExtensionElement(elementName: string): boolean;
